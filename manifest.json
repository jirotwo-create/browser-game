{
  "manifest_version": 3,
  "name": "Dreadwake \u2014 The Hollow Pilgrimage",
  "version": "1.10.1",
  "description": "A dark fantasy RPG in your side panel. Earn coins through browsing, forge gear, master forbidden arts, and face the Hollow.",
  "permissions": [
    "storage",
    "sidePanel",
    "alarms"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open Dreadwake",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png"
    }
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "hellscript-art.js",
        "effects.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  }
}
