extends SceneTree
var checks=0
var failures=[]
func check(ok,label):
 checks+=1
 if not ok:failures.append(label);push_error("FAIL: "+label)
func press(t,id,pos):t.handle_touch(id,pos,true)
func lift(t,id):t.handle_touch(id,Vector2.ZERO,false)
func _initialize():call_deferred("run")
func run():
 var g=load("res://game.gd").new();root.add_child(g);g.test_mode=true;g.set_process(false);g.set_physics_process(false)
 g.new_game()
 var t=g.touch_controls
 check(g.mobile_enabled and t!=null,"mobile mode enabled")
 check(g.screen.stretch_shrink==3,"phone default rendering resolution")
 check(Input.mouse_mode==Input.MOUSE_MODE_VISIBLE,"no captured mouse on touch")
 press(t,0,Vector2(155,510));check(t.move.y< -0.6,"joystick forward")
 var yaw=g.yaw;press(t,1,Vector2(750,400));t.handle_drag(1,Vector2(820,390),Vector2(70,-10))
 check(g.yaw<yaw and g.pitch>0,"independent finger looks")
 press(t,2,t.buttons.fire.p);check(t.held.fire,"third finger holds fire")
 check(t.move.y<0,"fire and look preserve movement")
 lift(t,2);check(not t.held.fire and t.move.y<0,"fire release independent of joystick")
 var look=g.yaw;t.handle_drag(1,Vector2(830,390),Vector2(10,0));check(g.yaw<look,"look persists after fire release")
 lift(t,0);check(t.move==Vector2.ZERO,"joystick release stops movement")
 lift(t,1);check(t.fingers.is_empty(),"all fingers released")
 press(t,0,t.buttons.jump.p);check(g.key(KEY_SPACE),"held jump connects to player input");lift(t,0)
 t.activate("sprint");check(g.key(KEY_SHIFT),"sprint toggle")
 t.activate("crouch");check(g.key(KEY_CTRL) and not g.key(KEY_SHIFT),"crouch disables sprint")
 t.activate("aim");check(t.aiming,"aim toggle")
 g.owned=[true,false,true,false,true];g.equipped=0;t.cycle_weapon(1);check(g.equipped==2,"next skips locked weapons")
 t.cycle_weapon(-1);check(g.equipped==0,"previous wraps owned weapons")
 g.equipped=0;g.magazines[0]=0;t.activate("reload");check(g.reload_t>0,"touch reload")
 g.dash_cd=0;t.activate("dash");check(g.dash_cd>0,"touch dash")
 g.pulse_cd=0;t.activate("audit");check(g.pulse_t>0,"touch audit sight")
 t.activate("map");check(g.state=="map" and t.move==Vector2.ZERO,"map clears gameplay input")
 t.menu_tap(Vector2(1180,150));check(g.state=="play","touch map close")
 t.activate("journal");check(g.state=="journal","journal opens")
 g.quests.union=1;t.menu_tap(Vector2(400,280));check(g.tracked=="union","tap journal quest to track")
 t.back();check(g.state=="play","Android Back closes journal")
 t.activate("pause");check(g.state=="pause","pause opens")
 t.menu_tap(Vector2(450,520));check(g.muted,"mute accessible by touch")
 t.menu_tap(Vector2(800,520));check(g.screen.stretch_shrink==2,"touch high detail")
 var old=t.sensitivity_scale;t.menu_tap(Vector2(600,661));check(t.sensitivity_scale==(old+1)%3,"touch look speed setting")
 t.menu_tap(Vector2(450,590));check(g.state=="help","help accessible")
 t.back();t.activate("pause");t.menu_tap(Vector2(700,290));check(g.state=="play","resume button")
 # A held finger must never continue firing after pausing or backgrounding.
 press(t,4,t.buttons.fire.p);g._notification(Node.NOTIFICATION_APPLICATION_PAUSED)
 check(g.state=="pause" and not t.held.fire and t.fingers.is_empty(),"background pauses and releases fingers")
 t.back();g.hud.dialogue_text="test";g.set_state("dialogue");t.menu_tap(Vector2(500,500));check(g.state=="play","dialogue closes by touch")
 g.set_state("fish");g.fish_target=0.5;g.fish_clock=0;t.menu_tap(Vector2(500,400));check(g.fish_caught==1,"touch fishing")
 t.back();g.hp=0;g.set_state("dead");t.back();check(g.hp>0 and g.state=="play","back from death respawns safely")
 g.set_state("ending");g.secrets=6;g.freed=["worker0","worker1","worker2"];t.menu_tap(Vector2(950,400));check(g.state=="won" and g.ending==2,"touch ending choice")
 t.menu_tap(Vector2(500,500));check(g.state=="title","touch ending returns to title")
 t.menu_tap(Vector2(250,660));check(g.state=="play" and g.seals.is_empty(),"touch new game")
 # Godot's real screen-touch event path, rather than calling the controller directly.
 var down=InputEventScreenTouch.new();down.index=9;down.position=t.buttons.fire.p;down.pressed=true
 t._input(down);check(t.held.fire,"InputEventScreenTouch press")
 down.pressed=false;t._input(down);check(not t.held.fire,"InputEventScreenTouch release")
 print("TOUCH CHECKS: ",checks," / FAILURES: ",failures.size())
 for f in failures:print("FAILED: ",f)
 g.free();quit(1 if not failures.is_empty() else 0)
